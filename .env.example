# ComputePulse environment template
#
# API: copy this file to apps/api/.env (or export the variables in your process manager).
# Web: copy only the web variables to apps/web/.env.local when the API is not on
#      http://localhost:8787. Next.js does not read a repository-root .env file.
#
# Never commit a populated .env file or an operator private key.

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Empty DATABASE_URL uses embedded PGlite for local evaluation.
# DATABASE_URL=postgresql://computepulse:change-me@localhost:5432/computepulse
DATABASE_URL=
PGLITE_DIR=.data/pglite

# The local workspace organisation ID. Keep the default for a fresh evaluation.
DEMO_ORG_ID=org_computepulse

# When set, mutating API routes require "Authorization: Bearer <token>".
# Leave empty only for local evaluation.
ADMIN_API_TOKEN=

# Replace with a long random value before storing real monitor credentials.
# The API warns in production when the development key is still in use.
CREDENTIAL_ENCRYPTION_KEY=computepulse-local-dev-key-change-me-32-bytes-minimum!!

# Collection and scheduling
COLLECTOR_ENABLED=true
MONITOR_SCHEDULER_ENABLED=true
AUTO_BOOTSTRAP=true
MONITOR_TICK_MS=30000
AKASH_INTERVAL_MS=300000
FLUX_INTERVAL_MS=600000
BOT_INTERVAL_MS=60000
ADAPTER_TIMEOUT_MS=90000
DEFAULT_STALE_AFTER_SECONDS=1800

# Monitor target policy. Values are comma-separated. Empty means no extra
# host restriction, while private/reserved addresses remain blocked by SSRF
# validation. Ports default to 443 and 80 when unset.
MONITOR_HOST_ALLOWLIST=
MONITOR_ALLOWED_PORTS=443,80

# Optional signed webhook destination secret. When empty, integrations remain
# unconfigured. Webhook payloads use X-ComputePulse-Signature.
WEBHOOK_SECRET=

# Optional transactional email. SMTP delivery is not implemented in the
# reference build; configuring this only changes integration readiness and
# delivery rows are recorded as skipped.
SMTP_URL=

# Optional tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=computepulse-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional distributed queue. Reserved for a future deployment; the reference
# runtime uses an in-process scheduler and does not require Redis.
REDIS_URL=

# Optional registry anchoring. No address is configured by default, so the UI
# honestly reports not_anchored. Never commit an operator private key.
INCIDENT_REGISTRY_ADDRESS=
BOT_OPERATOR_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Web runtime (apps/web/.env.local)
# ---------------------------------------------------------------------------
# Server-side API base URL used by Next.js server components.
# API_URL=http://localhost:8787
# Browser-visible API base URL for links and downloads.
# NEXT_PUBLIC_API_URL=http://localhost:8787
# Optional public contact address. When empty the contact page says so.
# CONTACT_EMAIL=
