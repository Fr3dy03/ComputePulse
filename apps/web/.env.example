# Vercel environment for the Next.js web app.
#
# Vercel project: root directory can stay at the repository root because
# vercel.json builds @computepulse/web. If you prefer selecting a root
# directory in the Vercel dashboard, use "apps/web".
#
# The API runs as a separate long-lived service. Set these values in
# Vercel Project Settings -> Environment Variables when that service exists.
# Without them the marketing site still renders and the app shows its honest
# API-unavailable state.

# Server-side API base URL used by Next.js server components.
API_URL=https://your-computepulse-api.example.com

# Browser-visible API base URL used by client components and downloads.
NEXT_PUBLIC_API_URL=https://your-computepulse-api.example.com

# Optional public contact address.
# CONTACT_EMAIL=ops@example.com
